#define kBundleIdentifier "com.andescotia.marten"#define kBundleVersion "1.2"#define kBundleShortVersion __OUTPUT_FILENAME__ " version " kBundleVersion// Change this to the string to display in the Finder's Get Info window#define kBundleGetInfo kBundleShortVersion ", Copyright ©2005 by Andescotia LLC. All rights reserved."plist{	dictionary	{		key "CFBundleIdentifier" value string kBundleIdentifier				key "CFBundleName" value string __OUTPUT_FILENAME__		key "CFBundleGetInfoString" value string kBundleGetInfo		key "CFBundleShortVersionString" value string kBundleShortVersion				key "CFBundlePackageType" value string __OUTPUT_TYPE__		key "CFBundleSignature" value string __OUTPUT_CREATOR__		key "CFBundleExecutable" value string __OUTPUT_FILENAME__		key "CFBundleVersion" value string kBundleVersion				key "CFBundleDevelopmentRegion" value string "English"		key "CFBundleInfoDictionaryVersion" value string "6.0"		key "LSRequiresCarbon" value boolean true				key "CFBundleIconFile" value string "martenIcon.icns"		key "CFBundleDocumentTypes" value array [	        dictionary{	                key "CFBundleTypeExtensions" value array[	                        string "vpx"	                ]	                key "CFBundleTypeOSTypes" value array[	                        string "vplP"	                ]	                key "CFBundleTypeIconFile" value string "VPX.icns"	                key "CFBundleTypeName" value string __OUTPUT_FILENAME__ " Project File"	                key "CFBundleTypeRole" value string "Editor"	        }	        dictionary{	                key "CFBundleTypeExtensions" value array[	                        string "vpl"	                ]	                key "CFBundleTypeOSTypes" value array[	                        string "vplS"	                ]	                key "CFBundleTypeIconFile" value string "VPL.icns"	                key "CFBundleTypeName" value string __OUTPUT_FILENAME__ " Section File"	                key "CFBundleTypeRole" value string "Editor"	        }	        dictionary{	                key "CFBundleTypeExtensions" value array[	                        string "app"	                ]	                key "CFBundleTypeOSTypes" value array[	                        string "APPL"	                ]	                //key "CFBundleTypeIconFile" value string "LibraryFile.icns"	                key "CFBundleTypeName" value string __OUTPUT_FILENAME__ " Application"	                key "CFBundleTypeRole" value string "Editor"	                key "LSTypeIsPackage" value boolean true	        }	        dictionary{	                key "CFBundleTypeExtensions" value array[	                        string "bundle"	                ]	                key "CFBundleTypeOSTypes" value array[	                        string "vplB"	                ]	                key "CFBundleTypeIconFile" value string "BNDL.icns"	                key "CFBundleTypeName" value string __OUTPUT_FILENAME__ " Library File"	                key "CFBundleTypeRole" value string "Viewer"	                key "LSTypeIsPackage" value boolean true	        }	        dictionary{	                key "CFBundleTypeExtensions" value array[	                        string "vpz"	                ]	                key "CFBundleTypeOSTypes" value array[	                        string "vplZ"	                ]	                key "CFBundleTypeIconFile" value string "VPZ.icns"	                key "CFBundleTypeName" value string __OUTPUT_FILENAME__ " Interpreter File"	                key "CFBundleTypeRole" value string "Editor"	        }	        dictionary{	                key "CFBundleTypeExtensions" value array[	                        string "pgs"	                ]	                key "CFBundleTypeOSTypes" value array[	                        string "PROG"	                ]	                //key "CFBundleTypeIconFile" value string "BNDL.icns"	                key "CFBundleTypeName" value string "Prograph CPX Section File"	                key "CFBundleTypeRole" value string "Viewer"	        }		]				key "LSMinimumSystemVersion" value string "10.3.0"		key "CFBundleURLTypes" value array[			dictionary{				key "CFBundleURLName" value string __OUTPUT_FILENAME__ " Project URL"				key "CFBundleURLSchemes" value array[					string "marten"					string "vpl"				]			}		]			}}// Change this to be localized for Englishlocalize "English"{	comment "Localized versions of Info.plist keys"	key "CFBundleName" value string __OUTPUT_FILENAME__	key "CFBundleGetInfoString" value string kBundleGetInfo	key "CFBundleShortVersionString" value string kBundleShortVersion		/*	comment "Alert strings"		key "VPLClassCreate" value string "The class %s does not exist.  Do you want to create it?"	key "VPLPersistentCreate" value string "The persistent %s does not exist.  Do you want to create it?"		key "VPLUniversalCreate" value string "The universal method %s does not exist.  Do you want to create it?"	key "VPLDuplicateAttribute" value string "An attribute named %s already exists."*/	}// Change this to be localized for Germanlocalize "German"{	comment "Localized versions of Info.plist keys"	key "CFBundleName" value string __OUTPUT_FILENAME__	key "CFBundleGetInfoString" value string kBundleGetInfo	key "CFBundleShortVersionString" value string kBundleShortVersion		/*	comment "Alert strings"		key "VPLClassCreate" value string "Das Kategorie %s besteht nicht. Möchten Sie es verursachen?"	key "VPLPersistentCreate" value string "Das hartnäckige %s besteht nicht.  Möchten Sie es verursachen?"		key "VPLUniversalCreate" value string "Das Universalmethode %s besteht nicht.  Möchten Sie es verursachen?"	key "VPLDuplicateAttribute" value string "Ein Attribut, das %s bestehen genannt wird bereits."*/	}